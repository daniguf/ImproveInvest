# ---------------------------------------------------------------------------
# Copy to `.env.local` (or `.env`) and fill in. Never commit the filled file.
#
#   cp .env.example .env.local
#
# `.env.example` itself is committed; `.gitignore` ignores `.env*` but makes an
# exception for this file.
# ---------------------------------------------------------------------------

# --- Sanity (required) ------------------------------------------------------
# Content API for the project/newsfeed documents. Both values are exposed to the
# browser, so they are configuration rather than secrets. Find them at
# https://sanity.io/manage -> your project -> API.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET=""

# --- Resend (required) ------------------------------------------------------
# Sends the contact form submissions from POST /api/contact. SECRET.
RESEND_API_KEY=""

# --- Admin API (required) ---------------------------------------------------
# Guards the internal consent-audit endpoints: GET/DELETE /api/consent-log and
# /api/gdpr/manage. Send it as either header:
#     Authorization: Bearer <key>
#     x-admin-key: <key>
# A `?key=` query parameter is deliberately rejected - it leaks the secret into
# request logs. An unset value disables both endpoints (HTTP 500, fail closed).
# SECRET.
ADMIN_API_KEY=""

# --- Consent audit log (required in production) -----------------------------
# HMAC key for the tamper-evident consent-log hash chain. SECRET.
# If this is unset, lib/consent-logger.ts only logs `console.warn` and continues
# signing with an empty key, which makes every signature worthless. It must be
# set in production, and rotating it invalidates the signature check for
# existing entries (the hash chain itself is unaffected).
CONSENT_LOG_HMAC_SECRET=""

# --- Vercel Blob (required) -------------------------------------------------
# The consent audit log is stored as the private blob `consent-audit.log`, not
# on the local filesystem (Vercel's filesystem is ephemeral and read-only
# outside /tmp). Vercel injects this token automatically in deployments; for
# local development create a Blob store and copy its read/write token here.
# SECRET.
BLOB_READ_WRITE_TOKEN=""
